# Auto detect text files and perform LF normalization
* text=auto

# Exclude documentation and config from language statistics
*.md linguist-documentation
*.json linguist-language=JSON
*.yml linguist-language=YAML
*.yaml linguist-language=YAML

# Mark generated files
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true

# Vendored code
public/sounds/* linguist-vendored

# Generated by Bubblewrap; whitespace stays as the generator wrote it so `update` is a no-op
android/** -whitespace linguist-generated=true
