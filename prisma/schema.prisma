generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id                    String    @id @default(cuid())
  email                 String?   @unique
  pendingEmail          String?   @unique
  emailVerified         DateTime? @db.Timestamptz(3)
  username              String?   @unique
  friendCode            String?   @unique // Short numeric code for adding friends (e.g., "12345")
  publicProfileId       String?   @unique // Stable public ID used in shareable profile links
  passwordHash          String?
  image                 String?
  avatarUrl             String?
  bio                   String?
  accentColor           String?
  featuredGame          String?
  premiumCardStyle      String?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  premiumUntil          DateTime? @db.Timestamptz(3)
  premiumCancelAtPeriod Boolean   @default(false)
  totpSecret            String?
  totpEnabled           Boolean   @default(false)
  totpPendingSecret     String?
  isGuest               Boolean   @default(false) // Flag for guest (temporary) users
  signupSource          String?   @db.VarChar(120) // Acquisition source captured at account creation (utm:/ref:/direct)
  role                  UserRole  @default(user)
  suspended             Boolean   @default(false)
  banReason             String?
  banExpiresAt          DateTime? @db.Timestamptz(3)
  lastActiveAt          DateTime  @default(now()) @db.Timestamptz(3) // Track last activity for all users
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  accounts Accounts[]
  lobbies  Lobbies[]  @relation("LobbyCreator")
  players  Players[]
  bot      Bots? // One-to-one relation with Bots table

  // Friend system
  sentFriendRequests      FriendRequests[]         @relation("SentRequests")
  receivedFriendRequests  FriendRequests[]         @relation("ReceivedRequests")
  friendshipsInitiated    Friendships[]            @relation("FriendshipsInitiated")
  friendshipsReceived     Friendships[]            @relation("FriendshipsReceived")
  sentLobbyInvites        LobbyInvites[]           @relation("LobbyInvitesSent")
  receivedLobbyInvites    LobbyInvites[]           @relation("LobbyInvitesReceived")
  adminAuditLogs          AdminAuditLogs[]         @relation("AdminAuditLogsActor")
  accountPreferences      AccountPreferences?
  notificationPreferences NotificationPreferences?
  notifications           Notifications[]
  pushSubscriptions       PushSubscriptions[]
  feedback                Feedback[]
  userAchievements        UserAchievements[]

  @@index([isGuest, lastActiveAt]) // Index for efficient guest cleanup
  @@index([role])
  @@index([suspended])
}

enum ProfileVisibility {
  public
  friends
  private
}

model AccountPreferences {
  id                    String            @id @default(cuid())
  userId                String            @unique
  user                  Users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVisibility     ProfileVisibility @default(public)
  showOnlineStatus      Boolean           @default(true)
  onboardingCompletedAt DateTime?         @db.Timestamptz(3)
  onboardingSkippedAt   DateTime?         @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([profileVisibility])
}

enum UserRole {
  user
  admin
}

// Bot players - separate table to avoid polluting Users with false isBot values
model Bots {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  botType    String   @default("yahtzee") // Game type: "yahtzee", "spy", etc.
  difficulty String   @default("medium") // Difficulty level: "easy", "medium", "hard"
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([botType])
}

model Accounts {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetTokens {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model EmailVerificationTokens {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Lobbies {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  password        String?
  maxPlayers      Int            @default(4)
  allowSpectators Boolean        @default(false)
  maxSpectators   Int            @default(10)
  spectatorCount  Int            @default(0)
  turnTimer       Int            @default(60) // Turn time limit in seconds (30, 60, 90, 120)
  isActive        Boolean        @default(true)
  gameType        GameType       @default(yahtzee)
  theme           String         @default("default")
  // Names the realtime broadcast topic alongside the code, so subscribing to a
  // lobby takes more than guessing four digits (#845). Generated by the
  // database so that every path which creates a lobby gets one.
  realtimeSecret  String         @default(dbgenerated("replace(gen_random_uuid()::text, '-', '')"))
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  creatorId       String?
  creator         Users?         @relation("LobbyCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  games           Games[]
  invites         LobbyInvites[]

  @@index([isActive])
  @@index([createdAt])
  @@index([creatorId])
  @@index([isActive, createdAt])
  @@index([isActive, gameType])
}

model LobbyInvites {
  id         String    @id @default(cuid())
  lobbyId    String
  lobby      Lobbies   @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  inviterId  String
  inviter    Users     @relation("LobbyInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId  String
  invitee    Users     @relation("LobbyInvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  channel    String    @default("friends")
  sentAt     DateTime  @default(now()) @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([lobbyId])
  @@index([inviterId])
  @@index([inviteeId])
  @@index([sentAt])
  @@index([acceptedAt])
}

model Games {
  id               String               @id @default(cuid())
  lobbyId          String
  lobby            Lobbies              @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  state            Json                 @db.JsonB
  status           GameStatus           @default(waiting)
  gameType         GameType             @default(yahtzee)
  abandonedAt      DateTime?            @db.Timestamptz(3)
  startedAt        DateTime?            @db.Timestamptz(3) // Set when game transitions waiting → playing
  endedAt          DateTime?            @db.Timestamptz(3) // Set on any terminal transition (finished/abandoned/cancelled)
  durationSeconds  Int? // floor((endedAt - startedAt) / 1000); null if no startedAt
  terminalMetadata Json?                @db.JsonB // { outcome, winnerUserId?, isDraw, reason?, playerResults[] }
  currentTurn      Int                  @default(0)
  lastMoveAt       DateTime             @default(now()) @db.Timestamptz(3) // Track when last move was made for timer
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  players          Players[]
  snapshots        GameStateSnapshots[]

  @@index([lobbyId])
  @@index([lobbyId, status])
  @@index([status])
  @@index([gameType, status])
  @@index([createdAt])
  @@index([startedAt])
  @@index([endedAt])
}

model GameStateSnapshots {
  id              String   @id @default(cuid())
  gameId          String
  game            Games    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  turnNumber      Int
  playerId        String?
  actionType      String
  actionPayload   Json?
  stateCompressed String   @db.Text
  stateEncoding   String   @default("gzip-base64")
  stateSize       Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([gameId, createdAt])
  @@index([gameId, turnNumber])
}

enum GameStatus {
  waiting
  playing
  finished
  abandoned
  cancelled
}

enum GameType {
  yahtzee
  tic_tac_toe
  rock_paper_scissors
  memory
  guess_the_spy
  connect_four
  telephone_doodle
  sketch_and_guess
  liars_party
  fake_artist
  alias
  other
}

enum FriendRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

/// Append-only record of who took part in a lobby, written when they join.
///
/// Deliberately has **no relation to Users**: guest rows are hard-deleted after
/// three days of inactivity and `Players.userId` cascades, which destroyed the
/// roster of 49% of all games and left the usable analytics window at four days
/// (#816). It is also written at join rather than at game start, so lobbies that
/// never started — 28% of them — still record how many people were waiting.
///
/// `participantKey` is a salted hash, never the user id or name: the goal is to
/// keep anonymised aggregates, not to outlive the guest-data retention rule.
model LobbyParticipations {
  id             String   @id @default(cuid())
  lobbyId        String
  lobbyCode      String
  gameType       GameType
  participantKey String
  isBot          Boolean  @default(false)
  isGuest        Boolean  @default(false)
  /// Where the participant came from, copied at join so it outlives the guest purge.
  signupSource   String?  @db.VarChar(120)
  joinedAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([lobbyId, participantKey])
  @@index([lobbyId])
  @@index([joinedAt])
  @@index([signupSource, joinedAt])
}

model Players {
  id              String    @id @default(cuid())
  gameId          String
  game            Games     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId          String
  user            Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score           Int       @default(0)
  finalScore      Int? // Final score after game ends
  placement       Int? // Final placement (1st, 2nd, 3rd, 4th)
  scorecard       String?   @db.Text // JSON string with game-specific scorecard
  position        Int // Player position in game (0, 1, 2, 3)
  isReady         Boolean   @default(false)
  isWinner        Boolean   @default(false)
  leftAt          DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  // Updated every ~10s by the client while a player has the lobby/game open
  // (see useLobbyHeartbeat). Used for zero-signal disconnect detection
  // (#675) — a stale value means the player closed their tab/browser
  // without ever calling the explicit leave API.
  lastHeartbeatAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
}

// Friend request system
model FriendRequests {
  id         String              @id @default(cuid())
  senderId   String
  sender     Users               @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   Users               @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(pending)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([createdAt])
}

// Friendship (accepted friend relationships)
model Friendships {
  id        String   @id @default(cuid())
  user1Id   String
  user1     Users    @relation("FriendshipsInitiated", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     Users    @relation("FriendshipsReceived", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // user1Id should always be less than user2Id to avoid duplicates
  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([createdAt])
}

// Spy Game Locations
model SpyLocations {
  id       String   @id @default(cuid())
  name     String   @unique // e.g., "Airport", "Hospital"
  category String // e.g., "Travel", "Public", "Entertainment"
  roles    String[] // Array of possible roles at this location
  isActive Boolean  @default(true)

  @@index([category])
  @@index([isActive])
}

model OperationalEvents {
  id            String   @id @default(cuid())
  eventName     String
  metricType    String
  gameType      String?
  isGuest       Boolean?
  success       Boolean?
  applied       Boolean?
  latencyMs     Int?
  targetMs      Int?
  attemptsTotal Int?
  reason        String?
  stage         String?
  statusCode    Int?
  source        String?
  payload       Json?
  occurredAt    DateTime @default(now()) @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([eventName, occurredAt])
  @@index([metricType, occurredAt])
  @@index([gameType, occurredAt])
}

model OperationalAlertStates {
  id                String    @id @default(cuid())
  alertKey          String    @unique
  isOpen            Boolean   @default(false)
  lastValue         Float?
  lastTriggeredAt   DateTime? @db.Timestamptz(3)
  lastNotifiedAt    DateTime? @db.Timestamptz(3)
  lastResolvedAt    DateTime? @db.Timestamptz(3)
  githubIssueNumber Int?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
}

enum NotificationType {
  game_invite
  turn_reminder
  friend_request
  friend_accepted
  feedback_thanks
  achievement_unlocked
}

enum NotificationChannel {
  email
  in_app
  push
}

enum NotificationStatus {
  queued
  processing
  sent
  skipped
  failed
}

model NotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  inAppNotifications Boolean @default(true)
  gameInvites        Boolean @default(true)
  turnReminders      Boolean @default(true)
  friendRequests     Boolean @default(true)
  friendAccepted     Boolean @default(true)
  pushNotifications  Boolean @default(false)
  unsubscribedAll    Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Notifications {
  id          String              @id @default(cuid())
  userId      String
  user        Users               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  channel     NotificationChannel @default(email)
  status      NotificationStatus  @default(queued)
  dedupeKey   String?
  reason      String?
  payload     Json?
  readAt      DateTime?           @db.Timestamptz(3)
  processedAt DateTime?           @db.Timestamptz(3)
  sentAt      DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([userId, channel, createdAt])
  @@index([userId, channel, readAt, createdAt])
  @@index([type, channel, status, createdAt])
  @@index([dedupeKey])
}

model PushSubscriptions {
  id        String   @id @default(cuid())
  userId    String
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

// Achievement *definitions* (key, name, description, icon, category) live in
// code (lib/achievements.ts) rather than a DB table — consistent with how
// game types/catalog entries are defined in this codebase (lib/game-registry.ts,
// lib/game-catalog.ts), and avoids a migration every time a new achievement
// is added. This table only tracks which keys a user has unlocked and when.
model UserAchievements {
  id             String   @id @default(cuid())
  userId         String
  user           Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  unlockedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, achievementKey])
  @@index([userId])
}

model AdminAuditLogs {
  id         String   @id @default(cuid())
  adminId    String
  admin      Users    @relation("AdminAuditLogsActor", fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, createdAt])
}

/// Processed Stripe webhook event ids, so a redelivered event is a no-op (#717).
/// Stripe retries on any non-2xx and can deliver the same event more than once;
/// without this, each delivery re-ran the subscription write.
model StripeWebhookEvents {
  id          String   @id // Stripe's event.id — the natural idempotency key
  type        String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([processedAt])
}

model Feedback {
  id        String   @id @default(cuid())
  type      String // 'bug' | 'feature' | 'other'
  status    String   @default("open") // 'open' | 'acknowledged' | 'done' | 'wont_fix'
  message   String
  email     String?
  pageUrl   String?
  userId    String?
  user      Users?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([type, createdAt])
  @@index([userId])
}
