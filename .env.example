# ============================================================
# BOARDLY - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git!
#
# Quick setup:
# 1. cp .env.example .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. For local dev, use localhost URLs
# 4. For production, use your deployed URLs
# ============================================================

# ------------------------------------------------------------
# NODE ENVIRONMENT
# ------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------
# DATABASE (PostgreSQL: local or hosted)
# ------------------------------------------------------------
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boardly_local
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/boardly_local
#
# Hosted Supabase example:
# Get your connection string from: https://app.supabase.com/project/_/settings/database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
# Direct connection URL for migrations (avoid pooler/pgBouncer for prisma migrate)
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# Supabase Client + Storage
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — server-side only, never expose to client
# Required for avatar uploads via Supabase Storage
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------
# AUTHENTICATION SECRETS (REQUIRED)
# ------------------------------------------------------------
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-min-32-characters-change-this

# Auth URL - use localhost for development, production URL for deployment
NEXTAUTH_URL=http://localhost:3000

# Optional. Signs guest JWTs separately from the NextAuth secret, so rotating one
# does not invalidate the other. Falls back to NEXTAUTH_SECRET when unset.
# GUEST_JWT_SECRET=your-guest-jwt-secret-min-32-characters
# GUEST_JWT_EXPIRES_IN=12h

# ------------------------------------------------------------
# PAYMENTS (Stripe)
# ------------------------------------------------------------
# Boardly Premium. Without these the /api/stripe/* routes fail; /premium itself still
# renders, monthly only, from the PREMIUM_BASE_PRICE fallback. The one non-billing
# casualty is deleting an account that holds a subscription, which fails closed with a
# 502 rather than leave a subscription nobody can cancel.
# Keys from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Signing secret for /api/stripe/webhook, from the endpoint's page in Stripe.
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
# The monthly Price id. Its list price is mirrored in PREMIUM_BASE_PRICE (lib/stripe.ts).
# STRIPE_PREMIUM_PRICE_ID=price_your_monthly_price_id
# The yearly Price id. Unset, only the monthly plan is offered - the yearly plan
# is never sold from a price this process cannot name.
# STRIPE_PREMIUM_PRICE_ID_YEARLY=price_your_yearly_price_id

# ------------------------------------------------------------
# REDIS (Upstash) - chat history and shared rate limiting
# ------------------------------------------------------------
# Two naming schemes, and lib/redis-credentials.ts reads both. Connecting
# Upstash directly sets the UPSTASH_* pair; connecting it through the Vercel
# Marketplace sets the KV_* ones. Set one pair, not both.
# Unset, chat history is not persisted and rate limiting falls back to a
# per-process in-memory counter.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
#
# Set by the Vercel Marketplace integration, alongside KV_URL, REDIS_URL and
# KV_REST_API_READ_ONLY_TOKEN, which nothing in this app reads.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your_kv_rest_token
# KV_URL=rediss://default:token@your-db.upstash.io:6379
# REDIS_URL=rediss://default:token@your-db.upstash.io:6379
# KV_REST_API_READ_ONLY_TOKEN=your_kv_read_only_token

# ------------------------------------------------------------
# EMAIL SERVICE (Resend)
# ------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Boardly <noreply@boardly.online>"
# Global daily cap on verification + password-reset mail (#1158). Optional; defaults to 80,
# which leaves headroom under Resend Free's 100/day. Raise it on a paid Resend plan.
# EMAIL_DAILY_SEND_BUDGET=80

# ------------------------------------------------------------
# OAUTH PROVIDERS (Optional - for social login)
# ------------------------------------------------------------
# Google OAuth - Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - Get from: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Discord OAuth - Get from: https://discord.com/developers/applications
# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret

# ------------------------------------------------------------
# DISCORD COMMUNITY SERVER (Optional - see docs/DISCORD.md)
# ------------------------------------------------------------
# Every variable below is optional. With none of them set the site still runs:
# feedback is stored but not mirrored to Discord, /discord redirects to the
# invite compiled into lib/discord.ts, and the internal bot routes answer 503.
#
# Channel webhook that /api/feedback mirrors submissions to, as an embed.
# Create it in Server Settings -> Integrations -> Webhooks. The embed carries
# the reporter's email, so point it at a staff-only channel.
# FEEDBACK_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token
#
# Invite that /discord redirects to, resolved by lib/discord.ts. NEXT_PUBLIC_
# so client components can read it, which also means it is inlined into the
# bundle at build time: changing it needs a rebuild, not a restart. Unset, the
# invite compiled into lib/discord.ts is used, so the redirect always works.
# NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite-code
#
# Id of the Boardly Discord application - the same application as
# DISCORD_CLIENT_ID above. Public value, used for Linked Roles.
# DISCORD_APPLICATION_ID=000000000000000000
#
# Shared secret the self-hosted gateway bot presents to the internal read-only
# routes. Generate with: openssl rand -base64 32
# The same value goes into the bot's env file on the Raspberry Pi.
# DISCORD_INTERNAL_SECRET=your-discord-internal-secret-min-32-characters

# ------------------------------------------------------------
# CRON JOB AUTHENTICATION (For automated tasks)
# ------------------------------------------------------------
# Generate secret with: openssl rand -base64 32
# Used to authenticate cron job requests (e.g., cleanup unverified accounts)
CRON_SECRET=your-cron-secret-key-min-32-characters-change-this
# Optional retention knobs for cleanup jobs.
# CLEANUP_GUEST_DAYS covers guests who never played a game; guests who did are
# kept for 90 days of inactivity, or for CLEANUP_GUEST_DAYS when that is set
# higher, whichever is longer (scripts/cleanup-old-guests.ts).
CLEANUP_GUEST_DAYS=3
REPLAY_RETENTION_DAYS=90

# ------------------------------------------------------------
# MCP (Model Context Protocol) SERVERS
# ------------------------------------------------------------
# GitHub Personal Access Token for MCP GitHub server
# Get token from: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:org, read:user
# Used by AI tooling (VSCode Copilot) for repository automation
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Database connection is shared from DATABASE_URL above.
# Optional only for hosted/TLS PostgreSQL when MCP scripts must enforce verify-full.
# Not needed for a local PostgreSQL instance on localhost.
# If your hosted URL uses `sslmode=require` and no custom CA bundle, runtime keeps
# libpq-compatible TLS semantics automatically. Set a CA path only when you want
# strict certificate verification (`verify-full`).
# MCP_POSTGRES_CA_CERT_PATH=./certs/postgres-ca.pem

# ------------------------------------------------------------
# INTERNAL SECRET (server-to-server bot turn requests)
# ------------------------------------------------------------
# Optional. When set, server-side bot-turn triggers authenticate via this secret.
# Without it, bot turns still work via client-side fallback (cookies).
# Generate with: openssl rand -base64 32
# Server-to-server bot turns. Without it the state route forwards the player's
# own session (guest token, bearer or cookie) to /bot-turn instead – fine for a
# local dev server, set it in every deployed environment.
# BOARDLY_INTERNAL_SECRET=your-boardly-internal-secret-here

# ------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------
HOSTNAME=0.0.0.0

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# BOT UX TIMING (Optional)
# ------------------------------------------------------------
# Controls artificial bot "human-like" delays.
# Defaults if unset (lib/bots/core/bot-ux-timing.ts):
# - BOT_UX_DELAY_SCALE=1.5
# - BOT_UX_DELAY_MIN_MS=0
# - BOT_UX_DELAY_MAX_MS=2000
#
# These only ever make a bot faster. Whatever they are set to, a single pause is
# capped at botUxDelayUpperBoundMs(base) - the executor's own base delay at the
# module's maximum scale and slowest difficulty. The client's bot-turn recovery
# grace is computed from that same bound in the browser, where these server-only
# variables cannot be read, and a bot allowed to outrun it takes a 409 on every
# turn (#1049).
#
# Force a fixed delay for all bot actions (overrides scale-based timing):
# BOT_UX_DELAY_MS=180
#
# Scale all bot executor base delays (0 = no artificial delay):
# BOT_UX_DELAY_SCALE=0.55
#
# Clamp final delay after scaling/override:
# BOT_UX_DELAY_MIN_MS=0
# BOT_UX_DELAY_MAX_MS=1200

# Allowed origins for security (optional)
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# ANALYTICS ACCESS CONTROL
# ------------------------------------------------------------
# Parsed by lib/env.ts, read by nothing else: the analytics page and its API
# moved to Boardly-control-panel in May 2026. Leave both empty here.
ANALYTICS_ALLOWED_USER_IDS=
ANALYTICS_ALLOWED_EMAILS=

# ------------------------------------------------------------
# OPERATIONS ALERTING & RELIABILITY KPI
# ------------------------------------------------------------
# Channel webhook for reliability alerts. The payload is a Discord embed, so
# this has to be a Discord channel webhook (see docs/DISCORD.md).
# OPS_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token
OPS_ALERT_WINDOW_MINUTES=10
OPS_ALERT_BASELINE_DAYS=7
OPS_ALERT_REPEAT_MINUTES=60
# Optional base URL for runbook links in notifications
# OPS_RUNBOOK_BASE_URL=https://github.com/<org>/<repo>/blob/main/
# GitHub token + repo for auto-creating/closing issues when alerts fire
# GITHUB_ALERT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_ALERT_REPO=KovalDenys1/Boardly

# ------------------------------------------------------------
# ERROR MONITORING (Sentry)
# ------------------------------------------------------------
# Get DSN from: https://sentry.io/settings/projects/
# 
# Development: Keep commented to disable Sentry and save quota
# Production: Uncomment and set to your Sentry DSN
# 
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Optional: Force enable Sentry in development
# NEXT_PUBLIC_SENTRY_ENABLED=true

# Sentry additional config (for source maps upload in CI/CD)
# Required only for uploading source maps during build
# SENTRY_ORG=your-org-name
# SENTRY_PROJECT=your-project-name
# SENTRY_AUTH_TOKEN=your-auth-token

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
# Set log level: debug | info | warn | error
# LOG_LEVEL=debug

# ============================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================
# When deploying to production (Vercel):
# 
# 1. Set NODE_ENV=production
# 2. Use production URLs for NEXTAUTH_URL and CORS_ORIGIN
# 3. Set BOARDLY_INTERNAL_SECRET for server-side bot-turn triggers (optional)
# 4. Ensure all secrets are properly set in hosting dashboard
# 5. Enable Sentry for error monitoring
# ============================================================

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:noreply@boardly.online

# AdSense display slots (components/AdSlot.tsx).
# Master switch for the ad units themselves, not the loader in app/layout.tsx.
# Leave unset until both are true: AdSense has approved boardly.online, and the
# Vercel plan is Pro (Hobby forbids commercial use, and ads make a site commercial).
# NEXT_PUBLIC_ADS_ENABLED=true

# Playing an unreleased game outside production (#1054).
# A game whose catalog entry is availability: 'in-development' cannot be started at
# all - isTemporarilyUnavailableGameType makes POST /api/lobby and POST /api/game/create
# answer 400 - which is circular, because the flip to 'available' is gated on the game
# having been played. These open that door on localhost and on Vercel previews only.
# The guard is VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV, which Vercel sets to 'production'
# on the production deployment and which nothing here can forge; leaving both unset
# locally is what makes the flags usable at all.
# ENABLE_IN_DEVELOPMENT_GAMES=true
# ENABLE_SKETCH_AND_GUESS=true

# ------------------------------------------------------------
# OPERATOR IMPRINT (Production only - set in Vercel, never in a file)
# ------------------------------------------------------------
# Name and geographic address of the person or company operating Boardly, which
# ehandelsloven section 8, angrerettloven section 8 d and GDPR Art. 13(1)(a)
# require on the site (#1163). NEXT_PUBLIC_ because the footer is a client
# component and, once published, the values are public by law; they are still
# personal, so they live in Vercel's Production environment and in no file.
# Address lines are separated by | (a real newline works too); lines are trimmed
# and empty ones dropped. The email shown next to them is SUPPORT_EMAIL from
# lib/organization-json-ld.ts.
# Until BOTH are set, the footer imprint, the "Who we are" section on /terms, the
# "Who is responsible for your data" section on /privacy and the footer of every
# email render nothing at all - never a half-filled line.
# NEXT_PUBLIC_SELLER_LEGAL_NAME=
# NEXT_PUBLIC_SELLER_ADDRESS=
